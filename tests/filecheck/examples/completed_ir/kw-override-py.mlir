// CHECK-LABEL:   builtin.module @Kw_ccpp_cap {
// CHECK:           "llvm.mlir.global"() <{global_type = !llvm.array<8 x i8>, sym_name = "str_kw_suite", linkage = #llvm.linkage<"internal">, addr_space = 0 : i32, constant, value = "kw_suite"}> ({
