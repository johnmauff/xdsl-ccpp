  long_name = pointer to one constituent's properties
  dimensions = ()
  type = ccpp_constituent_prop_ptr_t
  intent = out
[ errmsg ]
  standard_name = ccpp_error_message
  long_name = error message for error handling in CCPP
  units = none
  dimensions = ()
