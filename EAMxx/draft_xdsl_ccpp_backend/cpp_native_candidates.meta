  # zm_conv_convtran, zm_conv_momtran, and zm_conv_evap are all deliberately
  # NOT tagged here (genuinely needs Fortran, or pending on wv_saturation's
  # own portability for zm_conv_evap).


#################################################################
# gravity_wave_drag  (schemes/gravity_wave_drag/)
#################################################################
[ccpp-table-properties]
  name = gravity_wave_drag_prepare_profiles
  type = scheme
  cpp_native = pointwise
  # gravity_wave_drag_interstitials.F90: nm/ni/rhoi via a fixed 2-point
  # neighbor stencil -- bounded local difference, not a growing recurrence.

[ccpp-table-properties]
  name = gravity_wave_drag_top_taper
  type = scheme
  cpp_native = column_scan
  # init-only (no _run for this scheme): vramp(k)=vramp(k+1)/(...) -- an
  # explicit backward recursion, but it runs once on the fixed reference grid,
  # not per timestep.

# Every _run driver scheme in this package (orographic, ridge, ridge_beta,
# frontogenesis(+_inertial), convection_deep(+_shallow), moving_mountain) is
# deliberately NOT tagged: each computes its own wave-source spectrum then
# calls the shared gw_drag_prof engine in gw_common.F90 directly, and that
# engine is genuinely needs Fortran (two-pass column scan per wave mode plus
# an embedded implicit tridiagonal solve) -- see cross-cutting finding #2 in
# EAMxx-bridge-automation.md. Essentially the entire rest of this package is
# one of the least Phase-D-portable in the repo.


#################################################################
# rrtmgp  (schemes/rrtmgp/, schemes/radiation_utils/) -- SPECIAL CASE, see
# EAMxx-bridge-automation.md cross-cutting finding #2. These are pre/post-
# processing glue around the external RTE+RRTMGP library, not the radiative
# transfer itself. Tagged here for full-repo completeness per the request,
# but Phase D's hand-port-once-per-scheme treatment is very likely the wrong
# strategy for this package overall -- see that finding before acting on any
# of the entries below.
#################################################################
[ccpp-table-properties]
  name = rrtmgp_lw_calculate_heating_rate
  type = scheme
  cpp_native = pointwise
[ccpp-table-properties]
  name = rrtmgp_sw_calculate_heating_rate
  type = scheme
  cpp_native = pointwise
  # hrate(:,k)=(flux_net(:,k+1)-flux_net(:,k))*gravit*rpdel(:,k) -- a fixed
  # two-point stencil per level, no accumulated dependency.

[ccpp-table-properties]
  name = calculate_net_heating
  type = scheme
  cpp_native = pointwise
  # radiation_utils's utils/calculate_net_heating.F90: rad_heat=qrs_prime+
  # qrl_prime; net_flx per column.

[ccpp-table-properties]
  name = rrtmgp_dry_static_energy_tendency
  type = scheme
  cpp_native = pointwise
  # qrs_prime=qrs/pdel, elementwise.

[ccpp-table-properties]
  name = rrtmgp_lw_calculate_fluxes
  type = scheme
  cpp_native = pointwise
[ccpp-table-properties]
  name = rrtmgp_sw_calculate_fluxes
  type = scheme
  cpp_native = pointwise
  # Sign flip + slice extraction from an already-computed flux object --
  # trivial once that object exists, but porting requires deciding what
  # replaces the object it slices from (see the package-level caveat above).

[ccpp-table-properties]
  name = rrtmgp_lw_gas_optics_pre
  type = scheme
  cpp_native = pointwise
[ccpp-table-properties]
  name = rrtmgp_sw_gas_optics_pre
  type = scheme
  cpp_native = pointwise
  # Per-column/per-gas MMR->VMR conversion plus a closed-form O3-above-model-
  # top correction (column-local, level-1 only) -- but the result is written
  # into the RTE-RRTMGP gas-concentration object, so porting also means
  # deciding what that object becomes on the C++ side.

[ccpp-table-properties]
  name = rrtmgp_lw_aerosols
  type = scheme
  cpp_native = pointwise
  # Currently a stub (tau=0; own comment: "REMOVECAM: scheme is just a stub
  # for now") -- trivially portable as-is, but verify it's still a stub before
  # treating this as a real candidate.

# Every other rrtmgp scheme (the RTE solvers, gas-optics kernels, table
# loaders, mcica/RNG, cloud-optics, solar-var, pre/post/inputs DDT-lifecycle
# glue, constituent registration) is deliberately NOT tagged: each is either a
# thin wrapper directly calling the external RTE+RRTMGP Fortran library, or
# pure administrative/DDT-lifecycle bookkeeping with no radiative math of its
# own. See EAMxx-bridge-automation.md's full rrtmgp table.


#################################################################
# musica  -- NO CANDIDATES. All 4 top-level entry points (musica_ccpp_register/
# _init/_run/_final) are thin wrappers around opaque external solver objects
# (MICM's Rosenbrock/backward-Euler stiff-ODE solver; a TUV-x photolysis-rate
# object) -- there is no self-contained Fortran math in this repo to tag or
# port at all. See cross-cutting finding #2.
#################################################################


