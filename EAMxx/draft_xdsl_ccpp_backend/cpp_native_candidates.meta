  # long-term porting target even though they're trivial today.

# vertical_diffusion_diffuse_horizontal_momentum and
# vertical_diffusion_diffuse_tracers are deliberately NOT tagged -- see this
# file's header "KNOWN LIMITATION" note: each scheme's own _timestep_init/
# _init is trivial pointwise, but its _run calls an implicit tridiagonal (or
# LU-decomposition) solve in to_be_ccppized/vertical_diffusion_solver.F90 /
# vdiff_lu_solver.F90 -- genuinely needs Fortran, and cpp_native's per-scheme
# granularity can't express "tag only the trivial half."
# vertical_diffusion_diffuse_dry_static_energy is deliberately NOT tagged:
# genuinely needs Fortran outright (same implicit solve, no trivial phase).


#################################################################
# tropopause_find  (schemes/tropopause_find/tropopause_find.F90)
#################################################################
[ccpp-table-properties]
  name = tropopause_find
  type = scheme
  cpp_native = column_scan
  # Dispatches to ~6 internal algorithm variants (WMO, climate, hybrid-Stobie,
  # cold-point, chemical, primary+backup fallback chain), each a per-column
  # level-by-level search with a running "found" latch -- same scan-with-latch
  # shape as hb_pbl_dependent_coefficients above, now confirmed to recur
  # across packages rather than being a Kessler-suite curiosity.


