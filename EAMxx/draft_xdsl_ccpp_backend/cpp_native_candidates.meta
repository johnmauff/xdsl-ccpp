#################################################################
# hack_shallow  (schemes/hack_shallow/)
#################################################################
[ccpp-table-properties]
  name = set_general_conv_fluxes_to_shallow
  type = scheme
  cpp_native = pointwise
[ccpp-table-properties]
  name = set_shallow_conv_fluxes_to_general
  type = scheme
  cpp_native = pointwise
  # Both: pure elementwise array rename/copy between two field-naming schemes.

[ccpp-table-properties]
  name = convect_shallow_sum_to_deep
  type = scheme
  cpp_native = pointwise
  # Per-level array sums plus a per-column (not per-level) scalar min/max
  # merge of cloud-top/base indices -- independent across columns.

# hack_convect_shallow is deliberately NOT tagged: genuinely needs Fortran
# (full shallow-convection plume model, goto-derived control flow, explicit
# convergence tolerance, calls to_be_ccppized's qsat).


#################################################################
# tj2016  (schemes/tj2016/)
#################################################################
[ccpp-table-properties]
  name = tj2016_precip
  type = scheme
  cpp_native = pointwise
  # Closed-form per-(i,k) large-scale condensation, computes qsat inline
  # (no external call), single pass, no subcycling. The single cleanest
  # Phase D candidate found in the entire repo-wide D.2 survey.

[ccpp-table-properties]
  name = tj2016_sfc_pbl_hs
  type = scheme
  cpp_native = column_scan
  # A self-contained, two-pass inline Thomas-algorithm implicit PBL diffusion
  # solve (backward sweep computing CE/CFt/CFq, then a forward sweep applying
  # them) -- no external solver module call, unlike vertical_diffusion's
  # equivalent schemes below. Structurally an extension of the column-scan
  # family (two dependent passes), not a from-scratch design.


