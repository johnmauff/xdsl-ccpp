  name = rk_stratiform_check_qtlcwat
  type = scheme
  cpp_native = pointwise
[ccpp-table-properties]
  name = rk_stratiform_sedimentation
  type = scheme
  cpp_native = pointwise
[ccpp-table-properties]
  name = rk_stratiform_detrain_convective_condensate
  type = scheme
  cpp_native = pointwise
[ccpp-table-properties]
  name = rk_stratiform_external_forcings
  type = scheme
  cpp_native = pointwise
[ccpp-table-properties]
  name = rk_stratiform_condensate_repartioning
  type = scheme
  cpp_native = pointwise
[ccpp-table-properties]
  name = rk_stratiform_prognostic_cloud_water_tendencies
  type = scheme
  cpp_native = pointwise
[ccpp-table-properties]
  name = rk_stratiform_save_qtlcwat
  type = scheme
  cpp_native = pointwise
  # All 7: per-(i,k) combination of already-computed rate terms, array-wide
  # conditional init, or a per-level copy -- no recurrence.

[ccpp-table-properties]
  name = cloud_particle_sedimentation
  type = scheme
  cpp_native = column_scan
  # getflx's psi(i,k)=phi(i,k-1)*(...)+psi(i,k-1) is a cumulative top-down
  # integral; cfint2 does a per-column interval search + cubic-limited
  # interpolation across the whole column. Portable in principle (team-per-
  # column), but a materially more sophisticated numerical method than
  # PF::calculate_z_int -- budget more D.4 effort for this one than the others.

# prognostic_cloud_water is deliberately NOT tagged: genuinely needs Fortran
# (bounded 2-pass iteration, calls wv_saturation's findsp_vc, an iterative
# Newton-type solver). rk_stratiform_cloud_fraction_perturbation and
# rk_stratiform_cloud_optical_properties are deliberately NOT tagged either:
# both delegate to other non-portable code (compute_cloud_fraction_run;
# to_be_ccppized/cloud_optical_properties.F90's cldefr) rather than doing
# their own math.


#################################################################
# zhang_mcfarlane  (schemes/zhang_mcfarlane/)
#################################################################
[ccpp-table-properties]
  name = save_ttend_from_convect_deep
  type = scheme
  cpp_native = pointwise
[ccpp-table-properties]
  name = set_deep_conv_fluxes_to_general
  type = scheme
  cpp_native = pointwise
[ccpp-table-properties]
  name = set_general_conv_fluxes_to_deep
  type = scheme
  cpp_native = pointwise
  # All 3: zero-fill/accumulate or pure array copy, per level. These are the
