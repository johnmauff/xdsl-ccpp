#################################################################################
# DRAFT proposal (2026-08-25): cpp_native property annotations for every real
# CCPP scheme in atmospheric_physics that EAMxx-bridge-automation.md's D.2
# full-repo triage classified as "pointwise/elemental" or "column-scan" --
# i.e. a Phase D.3/D.4 candidate for a hand-ported, native C++ Kokkos device
# function instead of a Fortran-bridge call.
#
# This is NOT a replacement for any real .meta file in atmospheric_physics --
# it is a standalone reference showing, per scheme, what its own
# [ccpp-table-properties] block would gain if this property were adopted.
# See that scheme's own real .meta file (cited per entry, relative to
# atmospheric_physics/schemes/) for its full argument tables; nothing here
# duplicates them, and nothing here has been merged into the real repo.
#
# cpp_native = pointwise    -> scalar-in/scalar-out per (col,lev), no cross-level
#                              dependency within the scheme body.
# cpp_native = column_scan  -> needs a running dependency up/down the column.
# Omitted entirely          -> structurally superseded (no port needed -- nothing
#                              will ever call the native version) or genuinely
#                              needs Fortran (see EAMxx-bridge-automation.md's
#                              D.2 tables for why, per scheme).
#
# KNOWN LIMITATION, found while compiling this file: cpp_native is a per-SCHEME
# property (one [ccpp-table-properties] block covers ALL of a scheme's
# _init/_run/_timestep_*/_finalize entry points), but at least two real schemes
# have entry points that disagree on portability:
#   - vertical_diffusion_diffuse_horizontal_momentum: _timestep_init is trivial
#     pointwise, but _run calls an implicit tridiagonal solve (genuinely needs
#     Fortran). EXCLUDED below rather than mistagged.
#   - vertical_diffusion_diffuse_tracers: same shape (_init trivial, _run calls
#     an LU-decomposition solve). EXCLUDED below.
# Adopting cpp_native for real would need to either move it to per-arg-table
# granularity, or accept that a scheme with any non-portable entry point just
# doesn't get tagged at all -- this file takes the second, more conservative
# option throughout, so nothing below is a scheme with mixed portability.
#
# Confidence key (in each entry's comment):
#   [unconfirmed]  the scheme is *possibly* structurally superseded by an
#                  EAMxx-generic mechanism, but Kessler's own bridge comment
#                  hedges it ("I think"/"TODO ?"/"pretty sure") -- tagged here
#                  anyway since if the hedge resolves "not superseded," this is
#                  a ready-to-port candidate with no further shape analysis
#                  needed.
#   [pending]      excluded, not tagged -- classification depends on a
#                  to_be_ccppized dependency's own unresolved portability.
#   [unused]       tagged for full-repo completeness, but not referenced by
#                  any of this repo's 6 production suites today.
#   [names approx] the fork that classified this package reported the
#                  suite-XML scheme name but did not confirm the exact CCPP
#                  scheme name(s) against source -- verify before use.
#   no tag         ordinary code-shape classification, ready to use as-is.
#################################################################################


#################################################################
# utilities  (schemes/utilities/)
#################################################################
[ccpp-table-properties]
  name = calc_exner
  type = scheme
  cpp_native = pointwise
  # state_converters.F90: exner(:,k)=(pmid/ref_pres)**(rair/cpair), per level.
  # Already has a hand-written EAMxx analog, PF::exner_function (Category 1).

[ccpp-table-properties]
  name = temp_to_potential_temp
  type = scheme
  cpp_native = pointwise
  # state_converters.F90: theta(:,k)=temp(:,k)/exner(:,k). Analog:
  # PF::calculate_theta_from_T (Category 1).

[ccpp-table-properties]
  name = potential_temp_to_temp
  type = scheme
  cpp_native = pointwise
  # state_converters.F90: temp(:,k)=theta(:,k)*exner(:,k) -- inverse of the above.

[ccpp-table-properties]
  name = calc_dry_air_ideal_gas_density
  type = scheme
  cpp_native = pointwise
  # state_converters.F90: rho(:,k)=pmiddry(:,k)/(rair(:,k)*temp(:,k)). Trivial
  # shape, but Category 2's open physics question (does this agree with
  # EAMxx's own mass-weighted rho?) is independent of portability -- verify
  # the physics before wiring this in, not just the shape.

[ccpp-table-properties]
  name = wet_to_dry_water_vapor
  type = scheme
  cpp_native = pointwise
[ccpp-table-properties]
  name = wet_to_dry_cloud_liquid_water
  type = scheme
  cpp_native = pointwise
[ccpp-table-properties]
  name = wet_to_dry_cloud_ice
  type = scheme
  cpp_native = pointwise
[ccpp-table-properties]
  name = wet_to_dry_rain
  type = scheme
  cpp_native = pointwise
[ccpp-table-properties]
  name = dry_to_wet_water_vapor
  type = scheme
  cpp_native = pointwise
[ccpp-table-properties]
  name = dry_to_wet_cloud_liquid_water
  type = scheme
  cpp_native = pointwise
[ccpp-table-properties]
  name = dry_to_wet_cloud_ice
  type = scheme
  cpp_native = pointwise
[ccpp-table-properties]
  name = dry_to_wet_rain
  type = scheme
  cpp_native = pointwise
  # state_converters.F90, all 8: q_dry(:,k)=q(:,k)*(pdel(:,k)/pdeldry(:,k)) or
  # its inverse, per level. Not needed for Kessler today (qv/qc/qr are already
  # dry-basis on both sides), but trivially portable for a future suite that
  # does need them.

[ccpp-table-properties]
  name = convert_dry_constituent_tendencies_to_dry_air_basis
  type = scheme
  cpp_native = pointwise
  # per-(i,k,constituent) tend_q *= pdel/pdeldry, gated by a per-constituent
  # dry/wet flag lookup -- the lookup is a property query, not a portability
  # blocker.

[ccpp-table-properties]
  name = kessler_update
  type = scheme
  cpp_native = pointwise
  # kessler_update.F90: covers _timestep_init (temp_prev=temp; ttend_t=0),
  # _run (new_temp=theta*exner; ttend_t+=...), and _timestep_final
  # (st_energy=temp*cpair+gravit*zm+phis) -- all per-level, no cross-level
  # dependency. _timestep_final reads `gravit` from this module's own private
  # state (set once by kessler_update_init); porting means passing it as an
  # explicit argument, a trivial signature change.

[ccpp-table-properties]
  name = static_energy
  type = scheme
  cpp_native = pointwise
  # static_energy.F90's update_dry_static_energy_run: identical shape to
  # kessler_update_timestep_final above.

[ccpp-table-properties]
  name = apply_tendency_of_eastward_wind
  type = scheme
  cpp_native = pointwise
[ccpp-table-properties]
  name = apply_tendency_of_northward_wind
  type = scheme
  cpp_native = pointwise
[ccpp-table-properties]
  name = apply_heating_rate
  type = scheme
  cpp_native = pointwise
[ccpp-table-properties]
  name = apply_constituent_tendencies
  type = scheme
  cpp_native = pointwise
  # physics_tendency_updaters.F90, all 4: state += tend*dt, accumulate a
  # _total tendency, then zero the tendency array. Per level.

[ccpp-table-properties]
  name = apply_tendency_of_air_temperature
  type = scheme
  cpp_native = pointwise
  # [unconfirmed] physics_tendency_updaters.F90: same shape as the 4 above.
  # Kessler's bridge comment hedges "pretty sure eamxx does this with the
  # energy fixer... TODO ?" -- tagged anyway since it's trivially portable
  # either way if the hedge resolves "not superseded."

# qneg and geopotential_temp are deliberately NOT tagged here: both are
# [confirmed] structurally superseded (EAMxx's postcondition checks; EAMxx's
# own hand-written z_mid/z_int scan, respectively) -- nothing will ever call
# a native replacement for either, so there is nothing to port.


#################################################################
# conservation_adjust  (schemes/conservation_adjust/check_energy/, dme_adjust/)
#################################################################
[ccpp-table-properties]
  name = check_energy_fix
  type = scheme
  cpp_native = pointwise
  # ptend_s = heat_glob (scalar broadcast); eshflx from two fixed interface
  # levels -- not a recurrence.

[ccpp-table-properties]
  name = check_energy_save_teout
  type = scheme
  cpp_native = pointwise
  # teout(:ncol) = te_cur_dyn(:ncol) -- a bare per-column copy.

[ccpp-table-properties]
  name = check_energy_scaling
  type = scheme
  cpp_native = pointwise
  # [unconfirmed for its physics_after_coupler use; confirmed superseded
  # ("taken care of by HOMME") for its physics_before_coupler use in Kessler's
  # suite -- same code either way] scaling_dycore=cpairv/cp_or_cv_dycore, per
  # level. Trivially pointwise regardless of which supersession claim is right.

[ccpp-table-properties]
  name = dycore_energy_consistency_adjust
  type = scheme
  cpp_native = pointwise
  # [unconfirmed] tend_dTdt_local=(scaling_dycore-1)*tend_dTdt behind a
  # logical flag, per level. Kessler's bridge comment: "pretty sure eamxx does
  # this with the energy fixer... TODO ?".

[ccpp-table-properties]
  name = dme_adjust
  type = scheme
  cpp_native = column_scan
  # dme_adjust.F90: pint(:,k+1)=pint(:,k)+pdel(:,k) inside a do k=1,pver loop
  # -- level k+1 depends on the just-updated pint at level k, a genuine
  # recurrence. Early-returns entirely if not moist-dycore.

# check_energy_zero_fluxes and check_energy_chng are deliberately NOT tagged:
# both [confirmed] superseded by EAMxx's energy fixer via HOMME, and
# check_energy_chng additionally could never be ported regardless (its own
# source comment: "non-portable due to dependencies on cam_thermo").


