# entire repository -- not portable regardless of shape, and moot given
# they're unused.


#################################################################
# holtslag_boville  (schemes/holtslag_boville/)
#################################################################
[ccpp-table-properties]
  name = hb_diff_exchange_coefficients
  type = scheme
  cpp_native = pointwise
[ccpp-table-properties]
  name = hb_diff_free_atm_exchange_coefficients
  type = scheme
  cpp_native = pointwise
[ccpp-table-properties]
  name = hb_diff_set_total_surface_stress
  type = scheme
  cpp_native = pointwise
[ccpp-table-properties]
  name = hb_diff_prepare_vertical_diffusion_inputs
  type = scheme
  cpp_native = pointwise
[ccpp-table-properties]
  name = hb_free_atm_diff_prepare_vertical_diffusion_inputs
  type = scheme
  cpp_native = pointwise
  # All 5: per-(i,k) from same-level or fixed-table inputs, or per-column
  # vector sums, or array copies -- no cross-level output dependency.
  # hb_diff_(free_atm_)prepare_vertical_diffusion_inputs also construct a
  # Coords1D derived-type object (to_be_ccppized/coords_1d.F90) consumed
  # downstream -- trivial math, but porting means also wrapping that type.

[ccpp-table-properties]
  name = hb_pbl_independent_coefficients
  type = scheme
  cpp_native = pointwise
  # Mostly per-level pointwise; one two-level *input* stencil (shear/N²/Ri
  # from levels k and k+1 of input data only, not this scheme's own prior
  # output) -- a neighbor stencil, not a scan.

[ccpp-table-properties]
  name = hb_pbl_dependent_coefficients
  type = scheme
  cpp_native = column_scan
  # Top-down PBL-height search with a per-column "found" latch -- level k's
  # effect depends on whether an earlier (higher) level already found the PBL
  # top. Same scan-with-latch family as tropopause_find below.


