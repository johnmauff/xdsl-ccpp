#################################################################
[ccpp-table-properties]
  name = cloud_fraction_fice
  type = scheme
  cpp_native = pointwise
  # Per-(i,k) piecewise-linear temperature -> fice/fsnow map, no recurrence.

[ccpp-table-properties]
