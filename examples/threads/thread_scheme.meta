[ccpp-table-properties]
  name = thread_scheme
  type = scheme
  dependencies =

########################################################################
[ccpp-arg-table]
  name = thread_scheme_run
  type = scheme
[errmsg]
  standard_name = ccpp_error_message
  long_name = error message for error handling in CCPP
  units = none
  dimensions = ()
  type = character
  kind = len=*
  intent = out
[errflg]
  standard_name = ccpp_error_code
  long_name = error code for error handling in CCPP
  units = 1
  dimensions = ()
  type = integer
  intent = out
[thread]
  standard_name = thread_number
  long_name = thread number for testing multi-thread support
  units = index
  dimensions = ()
  type = integer
  intent = in
[data_array]
  standard_name = data_array
  long_name = per-thread data array
  units = m
  dimensions = (horizontal_dimension)
  type = real
  kind = kind_phys
  intent = inout
