<?xml version="1.0" encoding="UTF-8"?>
<!--
Suite for the ddthost C++ host example.
Two schemes in one group, matching examples/capgen's own chost suite
(minus setup_coeffs, not needed here):
  make_ddt (not environ_conditions) to exercise DDT flattening:
    - initialize: vmr (vmr_type, intent=out), ccpp_info (ccpp_info_t, intent=in)
    - run:        vmr (vmr_type, intent=inout), O3 and HNO3 (real arrays)
    - timestep_final: vmr (vmr_type, intent=in) — verifies O3/HNO3 values
  temp_calc_adjust: temp_calc(:,:) = 1.0 (ignores temp_level; output is
    2D (horizontal_dimension, vertical_layer_dimension), matching real
    capgen-v1's own rank for this standard_name)
-->
<suite name="ddthost_suite" version="1.0">
  <group name="physics">
    <scheme>make_ddt</scheme>
    <scheme>temp_calc_adjust</scheme>
  </group>
</suite>
